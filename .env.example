# Copy to .env and replace every CHANGE_ME value. Never commit .env.
APP_ENV=production

# 32+ random characters; do not reuse the database password.
APP_SECRET_KEY=CHANGE_ME_APP_SECRET_32_CHARS_MINIMUM
# Must exactly match the browser origin, including scheme and port.
APP_BASE_URL=https://billing.example.com
DOMAIN=billing.example.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=roommate_billing
POSTGRES_USER=roommate
# Use URL-safe characters for this local compose example.
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://roommate:CHANGE_ME_DB_PASSWORD@db:5432/roommate_billing

SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
ALLOW_REGISTRATION=false

# Keep false for local/offline; set a server-side key only if enabling.
LLM_ENABLED=false
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=model-with-tool-calling
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_STEPS=8
AGENT_MAX_INPUT_CHARS=4000

WEB_DIR=/app/web
LOG_LEVEL=INFO

BACKUP_RETENTION_DAYS=14
